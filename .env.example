# Copy to .env and fill in real values. .env is gitignored.

# JWT signing key (required). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-me-with-a-random-64-char-hex-string

# Database URL (optional). Leave unset to fall back to local SQLite (skyguard.db).
# Example Postgres: postgresql://skyguard:password@localhost:5432/skyguard
# DATABASE_URL=
